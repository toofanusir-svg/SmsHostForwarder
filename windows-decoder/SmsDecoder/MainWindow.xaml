<Window x:Class="SmsDecoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMS Decoder"
        Width="560" Height="560"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Base button style -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Padding"           Value="14,8"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"   Value="#018786"/>
            <Setter Property="Foreground"   Value="White"/>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"   Value="#44475A"/>
            <Setter Property="Foreground"   Value="White"/>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"   Value="#E53935"/>
            <Setter Property="Foreground"   Value="White"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"        Value="#2A2A3E"/>
            <Setter Property="Foreground"        Value="#CDD6F4"/>
            <Setter Property="CaretBrush"        Value="#CDD6F4"/>
            <Setter Property="BorderBrush"       Value="#44475A"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,6"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground"  Value="#BAC2DE"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title + monitor badge -->
            <RowDefinition Height="Auto"/>  <!-- key row -->
            <RowDefinition Height="Auto"/>  <!-- input label -->
            <RowDefinition Height="140"/>   <!-- input box -->
            <RowDefinition Height="Auto"/>  <!-- decode / clear buttons -->
            <RowDefinition Height="Auto"/>  <!-- result label -->
            <RowDefinition Height="*"/>     <!-- result box -->
            <RowDefinition Height="Auto"/>  <!-- copy / dismiss -->
        </Grid.RowDefinitions>

        <!-- ── Title row ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SMS Decoder"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#CDD6F4"/>
                <TextBlock Text="Decrypt messages from SMS Forwarder"
                           FontSize="12" Foreground="#6C7086" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Clipboard monitor toggle -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock x:Name="tbMonitorLabel"
                           Text="Clipboard monitor"
                           FontSize="12" Foreground="#BAC2DE"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ToggleButton x:Name="tbMonitor"
                              Width="44" Height="24"
                              Cursor="Hand"
                              Checked="Monitor_Checked"
                              Unchecked="Monitor_Unchecked"
                              ToolTip="Auto-detect encrypted text in clipboard">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="track" CornerRadius="12"
                                    Background="#44475A" Width="44" Height="24">
                                <Ellipse x:Name="thumb" Width="18" Height="18"
                                         Fill="White" HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track"  Property="Background" Value="#018786"/>
                                    <Setter TargetName="thumb"  Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="thumb"  Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- ── Encryption key ────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Content="Encryption Key"/>

            <PasswordBox x:Name="pbKey"
                         Grid.Row="1" Grid.Column="0"
                         Background="#2A2A3E" Foreground="#CDD6F4"
                         BorderBrush="#44475A" BorderThickness="1"
                         Padding="8,6" FontSize="13"
                         PasswordChar="●" Margin="0,0,8,0"/>

            <Button Grid.Row="1" Grid.Column="1"
                    Content="Save"  Margin="0,0,6,0"
                    Style="{StaticResource BtnSecondary}"
                    Click="SaveKey_Click"/>

            <Button Grid.Row="1" Grid.Column="2"
                    Content="Show / Hide"
                    Style="{StaticResource BtnSecondary}"
                    Click="ToggleKey_Click"/>
        </Grid>

        <!-- ── Input ─────────────────────────────────────────────────── -->
        <Label Grid.Row="2" Content="Encoded / Encrypted Input"/>

        <TextBox x:Name="tbInput"
                 Grid.Row="3"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,4,0,10"/>

        <!-- ── Action buttons ────────────────────────────────────────── -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="▶  Decode"
                    Style="{StaticResource BtnPrimary}"
                    Click="Decode_Click" Margin="0,0,8,0"/>
            <Button Content="✕  Clear"
                    Style="{StaticResource BtnSecondary}"
                    Click="Clear_Click"/>
            <TextBlock x:Name="tbStatus"
                       VerticalAlignment="Center"
                       FontSize="12" Margin="12,0,0,0"
                       Foreground="#A6E3A1"/>
        </StackPanel>

        <!-- ── Result ────────────────────────────────────────────────── -->
        <Label Grid.Row="5" Content="Decrypted Message"/>

        <Border Grid.Row="6" CornerRadius="6" Margin="0,4,0,10"
                Background="#2A2A3E" BorderBrush="#44475A" BorderThickness="1">
            <TextBox x:Name="tbResult"
                     BorderThickness="0" Background="Transparent"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="14" FontFamily="Consolas"
                     Foreground="#A6E3A1"/>
        </Border>

        <!-- ── Bottom buttons ────────────────────────────────────────── -->
        <StackPanel Grid.Row="7" Orientation="Horizontal">
            <Button Content="📋  Copy Result"
                    Style="{StaticResource BtnSecondary}"
                    Click="Copy_Click" Margin="0,0,8,0"/>
            <Button Content="✕  Dismiss"
                    Style="{StaticResource BtnDanger}"
                    Click="Dismiss_Click"/>
        </StackPanel>

    </Grid>
</Window>
