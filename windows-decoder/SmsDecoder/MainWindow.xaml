<Window x:Class="SmsDecoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMS Decoder"
        Width="560" Height="620"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary"   TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#018786"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#44475A"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BtnDanger"    TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#E53935"/><Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"       Value="#2A2A3E"/>
            <Setter Property="Foreground"       Value="#CDD6F4"/>
            <Setter Property="CaretBrush"       Value="#CDD6F4"/>
            <Setter Property="BorderBrush"      Value="#44475A"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="0,0,0,2"/>
        </Style>

        <!-- Toggle switch template (reusable) -->
        <ControlTemplate x:Key="ToggleSwitchTemplate" TargetType="ToggleButton">
            <Border x:Name="track" CornerRadius="12"
                    Background="#44475A" Width="44" Height="24">
                <Ellipse x:Name="thumb" Width="18" Height="18"
                         Fill="White" HorizontalAlignment="Left"
                         Margin="3,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="track" Property="Background" Value="#018786"/>
                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="thumb" Property="Margin"              Value="0,0,3,0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="Auto"/>  <!-- toggles row -->
            <RowDefinition Height="Auto"/>  <!-- key row -->
            <RowDefinition Height="Auto"/>  <!-- input label + paste -->
            <RowDefinition Height="90"/>    <!-- input (smaller) -->
            <RowDefinition Height="Auto"/>  <!-- action buttons -->
            <RowDefinition Height="Auto"/>  <!-- result label -->
            <RowDefinition Height="*"/>     <!-- result (larger) -->
            <RowDefinition Height="Auto"/>  <!-- bottom buttons -->
        </Grid.RowDefinitions>

        <!-- ── Title ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="SMS Decoder" FontSize="20" FontWeight="Bold" Foreground="#CDD6F4"/>
            <TextBlock Text="Decrypt messages from SMS Forwarder"
                       FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ── Toggles row ────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,12">

            <!-- Auto-decode toggle -->
            <TextBlock Text="Auto-decode" FontSize="12" Foreground="#BAC2DE"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ToggleButton x:Name="tbAutoDecode"
                          Width="44" Height="24" Cursor="Hand"
                          Margin="0,0,16,0"
                          ToolTip="Automatically decode when encrypted text is detected"
                          Template="{StaticResource ToggleSwitchTemplate}"
                          Checked="AutoDecode_Changed"
                          Unchecked="AutoDecode_Changed"/>

            <!-- Clipboard monitor toggle -->
            <TextBlock Text="Clipboard monitor" FontSize="12" Foreground="#BAC2DE"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ToggleButton x:Name="tbMonitor"
                          Width="44" Height="24" Cursor="Hand"
                          ToolTip="Watch clipboard for encrypted text"
                          Template="{StaticResource ToggleSwitchTemplate}"
                          Checked="Monitor_Checked"
                          Unchecked="Monitor_Unchecked"/>
        </StackPanel>

        <!-- ── Key ────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="3" Content="Encryption Key"/>

            <PasswordBox x:Name="pbKey"
                         Grid.Row="1" Grid.Column="0"
                         Background="#2A2A3E" Foreground="#CDD6F4"
                         BorderBrush="#44475A" BorderThickness="1"
                         Padding="8,6" FontSize="13"
                         PasswordChar="●" Margin="0,0,6,0"
                         PasswordChanged="PbKey_Changed"/>

            <Button Grid.Row="1" Grid.Column="1" Content="Save"
                    Style="{StaticResource BtnSecondary}"
                    Margin="0,0,6,0" Click="SaveKey_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Show / Hide"
                    Style="{StaticResource BtnSecondary}"
                    Click="ToggleKey_Click"/>
        </Grid>

        <!-- ── Input label + Paste button ────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Encoded / Encrypted Input"/>
            <Button Grid.Column="1" Content="📋 Paste"
                    Style="{StaticResource BtnSecondary}"
                    Padding="10,4" FontSize="12"
                    Click="Paste_Click"/>
        </Grid>

        <!-- ── Input box (smaller) ────────────────────────────────── -->
        <TextBox x:Name="tbInput"
                 Grid.Row="4"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,8"
                 TextChanged="Input_TextChanged"/>

        <!-- ── Action buttons ─────────────────────────────────────── -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="▶  Decode" Style="{StaticResource BtnPrimary}"
                    Click="Decode_Click" Margin="0,0,8,0"/>
            <Button Content="✕  Clear"  Style="{StaticResource BtnSecondary}"
                    Click="Clear_Click" Margin="0,0,8,0"/>
            <Button Content="⬡  Exit"   Style="{StaticResource BtnDanger}"
                    Click="Exit_Click"/>
            <TextBlock x:Name="tbStatus"
                       VerticalAlignment="Center" FontSize="12"
                       Margin="12,0,0,0" Foreground="#A6E3A1"/>
        </StackPanel>

        <!-- ── Result label ───────────────────────────────────────── -->
        <Label Grid.Row="6" Content="Decrypted Message"/>

        <!-- ── Result box (larger) ────────────────────────────────── -->
        <Border Grid.Row="7" CornerRadius="6" Margin="0,4,0,8"
                Background="#2A2A3E" BorderBrush="#44475A" BorderThickness="1">
            <TextBox x:Name="tbResult"
                     BorderThickness="0" Background="Transparent"
                     IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="14" FontFamily="Consolas"
                     Foreground="#A6E3A1"/>
        </Border>

        <!-- ── Bottom buttons ─────────────────────────────────────── -->
        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <Button Content="📋  Copy Result" Style="{StaticResource BtnSecondary}"
                    Click="Copy_Click" Margin="0,0,8,0"/>
            <Button Content="✕  Dismiss" Style="{StaticResource BtnDanger}"
                    Click="Dismiss_Click"/>
        </StackPanel>

    </Grid>
</Window>
